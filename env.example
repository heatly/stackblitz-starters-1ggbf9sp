# Environment Configuration for Lazorkit Integration Example

# Solana RPC Endpoint
# This is where transactions are sent to the Solana network
# Devnet (testing): https://api.devnet.solana.com
# Mainnet (production): https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Solana Cluster
# devnet = testing environment (free SOL from faucet)
# mainnet-beta = production network (real money)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Paymaster URL
# The service that sponsors gas fees for transactions
# Users don't need SOL, the paymaster covers it
# Public paymaster (development):
NEXT_PUBLIC_PAYMASTER_URL=https://paymaster.dev.solana.com/v1

# For production, use your own paymaster or a provider's:
# - Helius: https://api.helius.xyz/paymaster
# - Magic Eden: https://paymaster.magiceden.io
# - Custom: https://your-paymaster.com

# USDC Token Mint Address
# This is the contract address for USDC on Solana
# Devnet: EPjFWaLb3odccjf2cj6ipYKeS78Gb6piFmqgWXb462o9
# Mainnet: EPjFWaLb3odccjf2cj6ipYKeS78Gb6piFmqgWXb462o9 (same)
NEXT_PUBLIC_USDC_MINT=EPjFWaLb3odccjf2cj6ipYKeS78Gb6piFmqgWXb462o9

# Optional: Custom settings (not required)
# NEXT_PUBLIC_CUSTOM_PAYMASTER_URL=
# NEXT_PUBLIC_SESSION_TIMEOUT=86400000
# NEXT_PUBLIC_ENABLE_DEBUG=false
